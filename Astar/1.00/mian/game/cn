-- 清理函数
local function onCharacterAdded()
    -- 重新应用已启用的功能
    if flying then startFlying() end
    if speedEnabled then startSpeed() end
    if noclipEnabled then startNoclip() end
    if aimbotEnabled then startAimbot() end
    if silentAimEnabled then startSilentAim() end
    if rageEnabled then startRage() end
end

LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
