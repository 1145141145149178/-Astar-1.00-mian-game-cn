-- 获取玩家和角色
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- 飞行相关变量
local flying = false
local flySpeed = 50
local flyConnection = nil

-- 加速相关变量
local speedEnabled = false
local speedValue = 16
local speedConnection = nil

-- 穿墙相关变量
local noclipEnabled = false
local noclipConnection = nil

-- 自瞄相关变量
local aimbotEnabled = false
local silentAimEnabled = false
local aimFOV = 90
local aimPart = "Head"
local aimConnection = nil

-- 愤怒机器人相关变量
local rageEnabled = false
local rageConnection = nil

-- 获取角色
local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

-- 获取角色根部件
local function getRoot()
    local char = getCharacter()
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
end

-- 获取角色人类
local function getHumanoid()
    local char = getCharacter()
    return char:FindFirstChildOfClass("Humanoid")
end

-- 获取所有敌人
local function getEnemies()
    local enemies = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChildOfClass("Humanoid") then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum.Health > 0 then
                    table.insert(enemies, player)
                end
            end
        end
    end
    return enemies
end

-- 获取最近的敌人
local function getClosestEnemy()
    local root = getRoot()
    if not root then return nil end
    local closest = nil
    local closestDist = math.huge
    for _, player in ipairs(getEnemies()) do
        local char = player.Character
        if char then
            local targetRoot = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            if targetRoot then
                local dist = (root.Position - targetRoot.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = player
                end
            end
        end
    end
    return closest
end

-- 飞行功能
local function startFlying()
    if flyConnection then flyConnection:Disconnect() end
    local root = getRoot()
    if not root then return end
    local hum = getHumanoid()
    if not hum then return end
    
    hum.PlatformStand = true
    flying = true
    
    flyConnection = RunService.RenderStepped:Connect(function()
        if not flying then return end
        root = getRoot()
        if not root then return end
        
        local velocity = Vector3.new(0, 0, 0)
        local camera = workspace.CurrentCamera
        
        -- 计算移动方向
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            velocity = velocity + camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            velocity = velocity - camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            velocity = velocity - camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            velocity = velocity + camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            velocity = velocity + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            velocity = velocity - Vector3.new(0, 1, 0)
        end
        
        if velocity.Magnitude > 0 then
            velocity = velocity.Unit * flySpeed
        end
        
        root.Velocity = velocity
    end)
end

local function stopFlying()
    flying = false
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    local hum = getHumanoid()
    if hum then
        hum.PlatformStand = false
    end
end

-- 加速功能
local function startSpeed()
    if speedConnection then speedConnection:Disconnect() end
    speedEnabled = true
    speedConnection = RunService.RenderStepped:Connect(function()
        if not speedEnabled then return end
        local hum = getHumanoid()
        if hum then
            hum.WalkSpeed = speedValue
        end
    end)
end

local function stopSpeed()
    speedEnabled = false
    if speedConnection then
        speedConnection:Disconnect()
        speedConnection = nil
    end
    local hum = getHumanoid()
    if hum then
        hum.WalkSpeed = 16
    end
end

-- 穿墙功能
local function startNoclip()
    if noclipConnection then noclipConnection:Disconnect() end
    noclipEnabled = true
    noclipConnection = RunService.Stepped:Connect(function()
        if not noclipEnabled then return end
        local char = getCharacter()
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
end

local function stopNoclip()
    noclipEnabled = false
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
end

-- 自瞄功能
local function startAimbot()
    if aimConnection then aimConnection:Disconnect() end
    aimbotEnabled = true
    aimConnection = RunService.RenderStepped:Connect(function()
        if not aimbotEnabled then return end
        local target = getClosestEnemy()
        if not target then return end
        local char = target.Character
        if not char then return end
        
        local part = char:FindFirstChild(aimPart) or char:FindFirstChild("Head")
        if not part then return end
        
        -- 检查是否在FOV范围内
        local root = getRoot()
        if not root then return end
        local screenPos, onScreen = Camera:WorldToScreenPoint(part.Position)
        if onScreen then
            local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
            if dist <= aimFOV then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
            end
        end
    end)
end

local function stopAimbot()
    aimbotEnabled = false
    if aimConnection then
        aimConnection:Disconnect()
        aimConnection = nil
    end
end

-- 静默自瞄功能
local function startSilentAim()
    if aimConnection then aimConnection:Disconnect() end
    silentAimEnabled = true
    aimConnection = RunService.RenderStepped:Connect(function()
        if not silentAimEnabled then return end
        local target = getClosestEnemy()
        if not target then return end
        local char = target.Character
        if not char then return end
        
        local part = char:FindFirstChild(aimPart) or char:FindFirstChild("Head")
        if not part then return end
        
        -- 静默自瞄：修改鼠标位置
        local screenPos, onScreen = Camera:WorldToScreenPoint(part.Position)
        if onScreen then
            local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
            if dist <= aimFOV then
                -- 模拟鼠标移动
                local mouse = LocalPlayer:GetMouse()
                if mouse then
                    mouse.X = screenPos.X
                    mouse.Y = screenPos.Y
                end
            end
        end
    end)
end

local function stopSilentAim()
    silentAimEnabled = false
    if aimConnection then
        aimConnection:Disconnect()
        aimConnection = nil
    end
end

-- 愤怒机器人功能
local function startRage()
    if rageConnection then rageConnection:Disconnect() end
    rageEnabled = true
    rageConnection = RunService.RenderStepped:Connect(function()
        if not rageEnabled then return end
        local target = getClosestEnemy()
        if not target then return end
        local char = target.Character
        if not char then return end
        
        local part = char:FindFirstChild("Head")
        if not part then return end
        
        -- 愤怒机器人：自动瞄准并射击
        local root = getRoot()
        if not root then return end
        
        -- 面向目标
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
        
        -- 模拟射击（点击鼠标）
        local mouse = LocalPlayer:GetMouse()
        if mouse then
            mouse1down()
            task.wait(0.1)
            mouse1up()
        end
    end)
end

local function stopRage()
    rageEnabled = false
    if rageConnection then
        rageConnection:Disconnect()
        rageConnection = nil
    end
end

